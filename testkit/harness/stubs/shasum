#!/bin/sh
# 桩：兼容 `shasum -a 256 [-c]`。
# Windows/Git Bash 只有 sha256sum（不认 -a），macOS 只有 /usr/bin/shasum（认 -a）。
ALG=""
if [ "${1:-}" = "-a" ]; then ALG="$2"; shift 2; fi
if command -v sha256sum >/dev/null 2>&1; then
  exec sha256sum "$@"
fi
if [ -n "$ALG" ]; then
  exec /usr/bin/shasum -a "$ALG" "$@"
fi
exec /usr/bin/shasum "$@"